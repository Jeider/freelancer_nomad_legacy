      "role": "vendor",
      "pool": "bad_reputation",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0009.thn",
      "sha256": "556fd2e2f0124fe3634df09dc3d054bd4ded646cbc233b87124a110f49db6a32",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0009_l001_vendor.wav",
