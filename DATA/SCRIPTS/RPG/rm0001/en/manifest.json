      "sound": "DX_rm0001_frag0009_l001_vendor_en",
      "speech_seconds": 2.810791666666667,
      "scene_seconds": 4.260791666666666,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Sorry, son. I cannot help you. Your reputation is too poor."
    },
    {
      "id": "rm0001_frag0010",
      "role": "player",
      "pool": "ask_requirements",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0010.thn",
