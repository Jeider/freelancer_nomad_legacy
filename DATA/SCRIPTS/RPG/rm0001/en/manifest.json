      "sound": "DX_rm0001_frag0010_l001_player_en",
      "speech_seconds": 1.7652916666666667,
      "scene_seconds": 3.2152916666666664,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "What do you require of your drivers?"
    },
    {
      "id": "rm0001_frag0011",
      "role": "vendor",
      "pool": "legacy_requirements",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0011.thn",
      "sha256": "608f4f6ad47bfa7a9aac1d3a2492881b32d7d02e24cb7e14a843086401808a1b",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0011_l001_vendor.wav",
      "audio_sha256": "ce299e21cb6e9784a3ec07b86c5510b9a306d1196e10bbe107c060c09ab1c216",
      "sound": "DX_rm0001_frag0011_l001_vendor_en",
      "speech_seconds": 4.973541666666667,
      "scene_seconds": 6.423541666666667,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "We need reliable people. We will check your reputation first, then you can choose the number of wagons."
    },
    {
      "id": "rm0001_frag0012",
      "role": "player",
      "pool": "back",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0012.thn",
      "sha256": "d91d5d2b2b052b429775559f6ff6cb8706cbed0c490d944202b644a9a7e98d26",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0012_l001_player.wav",
      "audio_sha256": "8ccb34a12b4f96c9e69942428b9860055bb123238495a206bef9bd40d5cdf07f",
      "sound": "DX_rm0001_frag0012_l001_player_en",
      "speech_seconds": 1.501375,
      "scene_seconds": 2.9513749999999996,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Let us get back to the job."
    },
    {
      "id": "rm0001_frag0013",
      "role": "vendor",
      "pool": "resume",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0013.thn",
      "sha256": "33cfe9253d5f0c24873f99b6e0e64344dfa0a925cf325717661e948576301853",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0013_l001_vendor.wav",
      "audio_sha256": "279510ba665acd586367edeff304b24a697b0e5d45e7d6e6a5bddd813d631d34",
      "sound": "DX_rm0001_frag0013_l001_vendor_en",
      "speech_seconds": 2.5308333333333333,
      "scene_seconds": 3.980833333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "So, are you interested in working as a train driver?"
    },
    {
      "id": "rm0001_frag0014",
      "role": "player",
      "pool": "leave",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0014.thn",
      "sha256": "fc83da189150a192d2fe37d7486f8c41ed723327c7f529eda65a94941294cc21",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0014_l001_player.wav",
      "audio_sha256": "7cd6e14098137dd864e7e3802647dbc433b53fab15aa02a1bf6192767d0de932",
      "sound": "DX_rm0001_frag0014_l001_player_en",
      "speech_seconds": 1.8832916666666666,
      "scene_seconds": 3.3332916666666663,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Not right now. See you around."
    },
    {
      "id": "rm0001_frag0015",
      "role": "vendor",
      "pool": "farewell",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0015.thn",
      "sha256": "ca252e9e09b5b87cc03888ad61360493efa8a0a9f4c1ad75cb8260eeaec57324",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0015_l001_vendor.wav",
      "audio_sha256": "754a6b72489128218aa742d6cbaefee7d0a685fb39d5e0ec7fca6bba8f3617eb",
      "sound": "DX_rm0001_frag0015_l001_vendor_en",
      "speech_seconds": 1.8675,
      "scene_seconds": 3.3175,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "All right, Trent. See you around."
    },
    {
      "id": "rm0001_frag0016",
      "role": "vendor",
      "pool": "busy",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0016.thn",
      "sha256": "d0242f8ceb503905065db866e05328c5d59f76f25a7f672ab7fe2045fe804065",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0016_l001_vendor.wav",
      "audio_sha256": "5e6b4f5381329a01f608a242ce6df33f73d047df96f9ab2b76ae70ec4263dbde",
      "sound": "DX_rm0001_frag0016_l001_vendor_en",
      "speech_seconds": 2.8242083333333334,
      "scene_seconds": 4.274208333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "You already have an active assignment. Take care of that first."
    },
    {
      "id": "rm0001_frag0017",
      "role": "vendor",
      "pool": "failed",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0017.thn",
      "sha256": "53050cc2bbdfcf2533e0a1f58ac1a6ea4dad3791844ec37674774c0f5a6d2519",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0017_l001_vendor.wav",
      "audio_sha256": "a1d6ff3a0dd7bef5e2d4c4aa25eed4b2a221018b7dbcc709a5c6280004319567",
      "sound": "DX_rm0001_frag0017_l001_vendor_en",
      "speech_seconds": 3.0879166666666666,
      "scene_seconds": 4.537916666666666,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "I cannot issue the work order right now. Please come back later."
    },
    {
      "id": "rm0001_frag0018",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0018.thn",
      "sha256": "595b766cabfe7a56bf33803309c817edcc2c6197cda11e06e065dd07c301b7f2",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0018_l001_vendor.wav",
      "audio_sha256": "18c3482c6c7965ea63886bb88d939bb248571c08e6cbd9ae93e6ec00bda1dfa9",
      "sound": "DX_rm0001_frag0018_l001_vendor_en",
      "speech_seconds": 2.8938333333333333,
      "scene_seconds": 4.3438333333333325,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Hello, Trent. The local trade authority is at your service."
    },
    {
      "id": "rm0001_frag0019",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0019.thn",
      "sha256": "954ec1c0a93361753d002ee96942436aba5e153e80cc2333d12a9a70fb96f999",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0019_l001_vendor.wav",
      "audio_sha256": "a2d0380a89d61656eeaeefa7ac2f321164bc5e6b26da1c565b78b19d500e30f4",
      "sound": "DX_rm0001_frag0019_l001_vendor_en",
      "speech_seconds": 3.1575416666666665,
      "scene_seconds": 4.607541666666666,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Hello, Trent. I run the trade authority here. What can I do for you?"
    },
    {
      "id": "rm0001_frag0020",
      "role": "vendor",
      "pool": "issued",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0020.thn",
      "sha256": "a6e87e397589d9948cc2c4f6f9c38da9bec73b23bc37c57267c9c3f4937575e2",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0020_l001_vendor.wav",
      "audio_sha256": "538c58e1705a7b6852a85b38377f12d84b1cd0600d1909f6a92b72819bdf17a0",
      "sound": "DX_rm0001_frag0020_l001_vendor_en",
      "speech_seconds": 4.11525,
      "scene_seconds": 5.56525,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "The work order is issued. Launch when you are ready, Trent. The locomotive is waiting."
    },
    {
      "id": "rm0001_frag0021",
      "role": "vendor",
      "pool": "bad_reputation",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0021.thn",
      "sha256": "3f37e670782021a3ea3970863da0281f41eeeaede9df3d7e94a403c787f3552f",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0021_l001_vendor.wav",
      "audio_sha256": "ff2b4bfce2297f5eaca683a82c30eea4275e6b89f45c000e5f660283ff546d05",
      "sound": "DX_rm0001_frag0021_l001_vendor_en",
      "speech_seconds": 3.3493333333333335,
      "scene_seconds": 4.799333333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "With your reputation, I cannot entrust you with a train. Sorry, Trent."
    },
    {
      "id": "rm0001_frag0022",
      "role": "vendor",
      "pool": "licensed_offer",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0022.thn",
      "sha256": "2bc83891e491909bbed25ca51184f77eacd8691b0e658defddd3cd46f5df2131",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0022_l001_vendor.wav",
      "audio_sha256": "49322a0cc93b34d56c76c15296e402bfc29d575c5fd19a63492c295c94925193",
      "sound": "DX_rm0001_frag0022_l001_vendor_en",
      "speech_seconds": 7.00325,
      "scene_seconds": 8.45325,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Of course. We need train drivers. Your skill and licence determine how many wagons you may haul. Choose an assignment within your qualification."
    },
    {
      "id": "rm0001_frag0023",
      "role": "vendor",
      "pool": "licensed_requirements",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0023.thn",
      "sha256": "cec55ebdf54b24ce6b010b87dba5e29b1bf44fd297138a5cd6597923a2000bfe",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0023_l001_vendor.wav",
      "audio_sha256": "33d908f42ab32500b75c11a794ea7ba83e3b04c9c37386933e561556c13fe7d3",
      "sound": "DX_rm0001_frag0023_l001_vendor_en",
      "speech_seconds": 7.7977083333333335,
      "scene_seconds": 9.247708333333334,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "We check your reputation and train driver licence. Your qualification is permanent: once you reach ten wagons, you may take ten-wagon trains on later shifts too."
    },
    {
      "id": "rm0001_frag0024",
      "role": "player",
      "pool": "ask_tutorial",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0024.thn",
      "sha256": "a4d50b1d4127f9266918f3303d7f41a239e940081280fb25f022f0ef4b493957",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0024_l001_player.wav",
      "audio_sha256": "f1a27db64817fa86bface4d6a68ba0b5036612fea82bb70765ee817432abb067",
      "sound": "DX_rm0001_frag0024_l001_player_en",
      "speech_seconds": 2.2867083333333333,
      "scene_seconds": 3.736708333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Explain how to operate the locomotive."
    },
    {
      "id": "rm0001_frag0025",
      "role": "vendor",
      "pool": "tutorial",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0025.thn",
      "sha256": "f56ed1f2fb2d67c5841ff5d864ff84b8825cae5dea8bf8bc2e7c5807cf8a207d",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0025_l001_vendor.wav",
      "audio_sha256": "abb824c0a49329cbfb9794f33c05655bebdbed8729a51e41a41208f7885d4aee",
      "sound": "DX_rm0001_frag0025_l001_vendor_en",
      "speech_seconds": 5.2504583333333334,
      "scene_seconds": 6.700458333333334,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Let us go through boarding the locomotive, coupling the wagons, and making a delivery. Where shall we start?"
    },
    {
      "id": "rm0001_frag0026",
      "role": "player",
      "pool": "ask_boarding",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0026.thn",
      "sha256": "fbc6e803b3414f4f9c7e560aeef3145a7751ece1aab1527935448c7ad1d8d126",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0026_l001_player.wav",
      "audio_sha256": "a95271d3d07ed59b395daa4a2baa9baf0961d5efda87998e6bf8040dbfa49a81",
      "sound": "DX_rm0001_frag0026_l001_player_en",
      "speech_seconds": 1.6780416666666667,
      "scene_seconds": 3.128041666666667,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "How do I board the locomotive?"
    },
    {
      "id": "rm0001_frag0027",
      "role": "vendor",
      "pool": "boarding",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0027.thn",
      "sha256": "529accb725edcf700566393ef74a2017346b9ef2206df805cb380dc5614eec44",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0027_l001_vendor.wav",
      "audio_sha256": "3a28dea7b03ca00d8aa6aa6f7db6f666b66156185b1f0d9e9e1de3cac05843a4",
      "sound": "DX_rm0001_frag0027_l001_vendor_en",
      "speech_seconds": 9.763458333333332,
      "scene_seconds": 11.213458333333334,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Take the work order and launch. The locomotive is waiting by the docking fixture, marked as your objective. Select it and use the normal docking command to take the controls. Your own ship will be stored."
    },
    {
      "id": "rm0001_frag0028",
      "role": "player",
      "pool": "ask_coupling",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0028.thn",
      "sha256": "c5ee105462bca433395b40149e38b2224a726de0fd0e0bf2d72b9a4fa1d8a1f9",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0028_l001_player.wav",
      "audio_sha256": "0023670bbd3c16a54c4afb0f64c851ededa654137191217e2d0943a8d11e4a39",
      "sound": "DX_rm0001_frag0028_l001_player_en",
      "speech_seconds": 1.4245833333333333,
      "scene_seconds": 2.8745833333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "How do I couple the wagons?"
    },
    {
      "id": "rm0001_frag0029",
      "role": "vendor",
      "pool": "coupling",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0029.thn",
      "sha256": "559db79533eed8728232becc04cafd959921e54f3261c4ee95aa7cd01de4341c",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0029_l001_vendor.wav",
      "audio_sha256": "49717fc7254a1fe3308a442449cc8ddb271b7429c5acebed57286ca39f56c8d5",
      "sound": "DX_rm0001_frag0029_l001_vendor_en",
      "speech_seconds": 12.023916666666667,
      "scene_seconds": 13.473916666666668,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "At the pickup marker, turn off cruise and autopilot. Align with the wagons and bring the rear coupling up to the first wagon: within fifteen metres, at a closing speed no higher than two metres per second. Press Couple wagons and wait for confirmation."
    },
    {
      "id": "rm0001_frag0030",
      "role": "player",
      "pool": "ask_delivery",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0030.thn",
      "sha256": "47eaf454677dfb2162d0ff51f3d7d14c20f1b7d426523e8d64d24c4446fb541b",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0030_l001_player.wav",
      "audio_sha256": "9dbe4b95c343181683c4881d4b89a73a6fce68537f0e1f453d5b32990acce7c2",
      "sound": "DX_rm0001_frag0030_l001_player_en",
      "speech_seconds": 2.6125833333333333,
      "scene_seconds": 4.0625833333333325,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "How do I deliver the cargo and uncouple the train?"
    },
    {
      "id": "rm0001_frag0031",
      "role": "vendor",
      "pool": "delivery",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0031.thn",
      "sha256": "37ac58599b32fcfcee31c768248a06988fd665821ca11131e1df90fdd29e3a70",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0031_l001_vendor.wav",
      "audio_sha256": "32a3e31181c95da0aa741dd7be0f3466180c1f728425136a0a94fa60eccfe2d0",
      "sound": "DX_rm0001_frag0031_l001_vendor_en",
      "speech_seconds": 11.157083333333333,
      "scene_seconds": 12.607083333333334,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "The work order names the destination system, and navigation shows the route. Bring the wagons to the delivery marker, turn off cruise and autopilot, and stop. Press Uncouple wagons, then wait for delivery and payment confirmation."
    },
    {
      "id": "rm0001_frag0032",
      "role": "player",
      "pool": "tutorial_back",
      "path": "SCRIPTS/RPG/rm0001/en/rm0001_frag0032.thn",
      "sha256": "d7320ee6f2c96733dbfd1a27c49af7bea5fece133097b47ff31d2427451826a4",
      "audio": "AUDIO/MOD_ENG/RPG/rm0001/rm0001_frag0032_l001_player.wav",
      "audio_sha256": "922961b50ca547e6e5388b300b39da286885579c8b635f6ef11230eb36d77ae6",
      "sound": "DX_rm0001_frag0032_l001_player_en",
      "speech_seconds": 2.1094583333333334,
      "scene_seconds": 3.559458333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "I have another question about the locomotive."
    }
