    "fragments": [
      {
        "id": "rm0101_frag0001",
        "role": "vendor",
        "pool": "greeting",
        "ru": "Добро пожаловать. Линкор Принц Уэльский. Я комендант стоянки Whitmore. Нужно место для корабля?",
        "en": "Welcome to Battleship Prince of Wales. I am Commandant Whitmore. I handle parking berths here."
      },
      {
        "id": "rm0101_frag0002",
        "role": "player",
        "pool": "ask_buy",
        "ru": "Хочу купить место для своего корабля.",
        "en": "I'd like to buy a berth for my ship."
      },
      {
        "id": "rm0101_frag0003",
        "role": "vendor",
        "pool": "quote",
        "ru": "Вот условия покупки. Проверь стоимость и подтверди, если всё устраивает.",
        "en": "Here are the terms. Check the price, and confirm if you're ready to proceed."
      },
      {
        "id": "rm0101_frag0004",
        "role": "player",
        "pool": "confirm",
        "ru": "Условия устраивают. Оформляйте одно место.",
        "en": "The terms look good. I'll take one berth."
      },
      {
        "id": "rm0101_frag0005",
        "role": "vendor",
        "pool": "success",
        "ru": "Оплата принята. Линкор Принц Уэльский: место закреплено за тобой. Можешь оставить корабль.",
        "en": "Payment received. Your berth at Battleship Prince of Wales is registered. You can store a ship here now."
      },
      {
        "id": "rm0101_frag0006",
        "role": "player",
        "pool": "cancel",
        "ru": "Пока отложим покупку.",
        "en": "Let's hold off on the purchase."
      },
      {
        "id": "rm0101_frag0007",
        "role": "vendor",
        "pool": "resume",
        "ru": "Хорошо. Что ещё тебя интересует?",
        "en": "All right. What else would you like to know?"
      },
      {
        "id": "rm0101_frag0008",
        "role": "player",
        "pool": "ask_rules",
        "ru": "Какие у вас условия хранения кораблей?",
        "en": "What are the rules for storing ships here?"
      },
      {
        "id": "rm0101_frag0009",
        "role": "vendor",
        "pool": "rules",
        "ru": "Место покупается навсегда. Заберёшь корабль — место останется твоим. Текущий корабль отдельного места не занимает.",
        "en": "A berth is yours permanently. It stays yours when you collect the ship. Your current ship doesn't take up a berth."
      },
      {
        "id": "rm0101_frag0010",
        "role": "player",
        "pool": "ask_scope",
        "ru": "Это место будет доступно и на других базах?",
        "en": "Can I use that berth at other bases too?"
      },
      {
        "id": "rm0101_frag0011",
        "role": "vendor",
        "pool": "scope",
        "ru": "Место действует только здесь: Линкор Принц Уэльский. На другой базе его нужно покупать отдельно.",
        "en": "This berth is only valid at Battleship Prince of Wales. You will need a separate berth at any other base."
      },
      {
        "id": "rm0101_frag0012",
        "role": "player",
        "pool": "ask_full",
        "ru": "А если все мои места будут заняты?",
        "en": "What happens when all my berths are occupied?"
      },
      {
        "id": "rm0101_frag0013",
        "role": "vendor",
        "pool": "full",
        "ru": "Ещё один корабль поставить не получится. Но можно забрать оставленный или обменять его на текущий. Для обмена свободное место не нужно.",
        "en": "You won't be able to park another ship. You can still collect a stored ship or swap it with your current one. A swap doesn't need an empty berth."
      },
      {
        "id": "rm0101_frag0014",
        "role": "vendor",
        "pool": "no_money",
        "ru": "На счету недостаточно кредитов. Оплата не прошла. Возвращайся, когда будет нужная сумма.",
        "en": "You don't have enough credits. No payment was taken. Come back when you have the funds."
      },
      {
        "id": "rm0101_frag0015",
        "role": "vendor",
        "pool": "maximum",
        "ru": "Ты уже приобрёл все доступные тебе места на этой базе. Ещё одно оформить не могу.",
        "en": "You already own the maximum number of berths at this base. I cannot register another one."
      },
      {
        "id": "rm0101_frag0016",
        "role": "vendor",
        "pool": "error",
        "ru": "Оформить покупку не удалось. Деньги не списаны. Давай проверим условия ещё раз.",
        "en": "The purchase couldn't be completed. You haven't been charged. Let's check the terms again."
      },
      {
        "id": "rm0101_frag0017",
        "role": "player",
        "pool": "back",
        "ru": "Вернёмся к покупке места.",
        "en": "Let's get back to buying a berth."
      },
      {
        "id": "rm0101_frag0018",
        "role": "player",
        "pool": "leave",
        "ru": "На этом всё. До встречи, комендант.",
        "en": "That is all for now. Goodbye, Commandant."
      },
      {
        "id": "rm0101_frag0019",
        "role": "vendor",
        "pool": "farewell",
        "ru": "До встречи, Трент. Удачных полётов.",
        "en": "Goodbye, Trent. Safe flying."
      },
      {
        "id": "rm0101_frag0020",
        "role": "vendor",
        "pool": "greeting",
        "ru": "С возвращением. Комендант Whitmore слушает. По поводу стоянки?",
        "en": "Welcome back. Commandant Whitmore speaking. Here about ship storage?"
      },
      {
        "id": "rm0101_frag0021",
        "role": "vendor",
        "pool": "greeting",
        "ru": "Привет, Трент. Стоянка базы «Линкор Принц Уэльский» к твоим услугам.",
        "en": "Hello, Trent. Need another berth at Battleship Prince of Wales?"
      },
      {
        "id": "rm0101_frag0022",
        "role": "vendor",
        "pool": "success",
        "ru": "Готово. Место оплачено и закреплено за тобой. Пользуйся.",
        "en": "All done. The berth is paid for and registered in your name. It's yours to use."
      },
      {
        "id": "rm0101_frag0023",
        "role": "vendor",
        "pool": "bad_reputation",
        "ru": "Не могу продать тебе место. Твоя репутация у нашей фракции должна быть положительной.",
        "en": "I cannot sell you a berth. Your reputation with our faction must be positive."
      }
    ],
