      "audio": "AUDIO/MOD/RPG/rm0139/rm0139_frag0022_l001_vendor.wav",
      "audio_sha256": "968a6e73a5ad28ac6b7c8f29ae394b27a56b1717299fa0a4a53b7f22699864b0",
      "sound": "DX_rm0139_frag0022_l001_vendor_ru",
      "speech_seconds": 4.0295,
      "scene_seconds": 5.4795,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Готово. Место оплачено и закреплено за тобой. Пользуйся."
    },
    {
      "id": "rm0139_frag0023",
      "role": "vendor",
      "pool": "bad_reputation",
      "path": "SCRIPTS/RPG/rm0139/ru/rm0139_frag0023.thn",
      "sha256": "1aa832d669d58789a8c855e48d4ab4cc31e2fe1fc4a41b211e53a1e0e02ce071",
      "audio": "AUDIO/MOD/RPG/rm0139/rm0139_frag0023_l001_vendor.wav",
      "audio_sha256": "fe39ce0e1870974185fb32e9a305d28735bbc5005a292e4bfe2bfd8c92624677",
