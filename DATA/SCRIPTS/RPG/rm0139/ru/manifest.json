    {
      "id": "rm0139_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0139/ru/rm0139_frag0021.thn",
      "sha256": "fa437c803541d86ea773ccf266d3f8b29a1b09e810fb76923dae550f1d9d1931",
      "audio": "AUDIO/MOD/RPG/rm0139/rm0139_frag0021_l001_vendor.wav",
      "audio_sha256": "2f1c580ef42e1d27a8f36683d52254a75966cd113f38323dcf25202ee91e74c2",
      "sound": "DX_rm0139_frag0021_l001_vendor_ru",
      "speech_seconds": 2.7545,
      "scene_seconds": 4.2044999999999995,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Привет, Трент. Стоянка к твоим услугам."
    },
    {
      "id": "rm0139_frag0022",
      "role": "vendor",
      "pool": "success",
      "path": "SCRIPTS/RPG/rm0139/ru/rm0139_frag0022.thn",
