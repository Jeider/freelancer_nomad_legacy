      "id": "rm0104_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0104/ru/rm0104_frag0021.thn",
      "sha256": "d5ca58c2fcf56282fa0e41c5d2dd381ac56fe6fde6e19bb9381555c667f8719b",
      "audio": "AUDIO/MOD/RPG/rm0104/rm0104_frag0021_l001_vendor.wav",
      "audio_sha256": "2f1c580ef42e1d27a8f36683d52254a75966cd113f38323dcf25202ee91e74c2",
