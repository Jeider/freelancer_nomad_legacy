      "sound": "DX_rm0130_frag0014_l001_vendor_ru",
      "speech_seconds": 6.346,
      "scene_seconds": 7.796,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "На счету недостаточно кредитов. Оплата не прошла. Возвращайся, когда будет нужная сумма."
    },
    {
      "id": "rm0130_frag0015",
      "role": "vendor",
      "pool": "maximum",
      "path": "SCRIPTS/RPG/rm0130/ru/rm0130_frag0015.thn",
      "sha256": "b49e90cdf735c4120647bbdcb8233115f7012beb61af4e72955c4c727a738531",
      "audio": "AUDIO/MOD/RPG/rm0130/rm0130_frag0015_l001_vendor.wav",
