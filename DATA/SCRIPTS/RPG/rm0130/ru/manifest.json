      "sound": "DX_rm0130_frag0015_l001_vendor_ru",
      "speech_seconds": 5.673583333333333,
      "scene_seconds": 7.123583333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Ты уже приобрёл все доступные тебе места на этой базе. Ещё одно оформить не могу."
    },
    {
      "id": "rm0130_frag0016",
      "role": "vendor",
      "pool": "error",
      "path": "SCRIPTS/RPG/rm0130/ru/rm0130_frag0016.thn",
      "sha256": "b90c1510b217a86725c6dc4d04a45a6af4ab4268d270eb7e9a676b6459e018fd",
      "audio": "AUDIO/MOD/RPG/rm0130/rm0130_frag0016_l001_vendor.wav",
