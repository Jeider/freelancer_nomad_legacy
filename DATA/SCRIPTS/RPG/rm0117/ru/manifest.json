      "audio_sha256": "f552b7bd39259ecf3221028d379d1c96b3d738f743dd8fc190ed5e8b8643dbc8",
      "sound": "DX_rm0117_frag0012_l001_player_ru",
      "speech_seconds": 2.4430833333333335,
      "scene_seconds": 3.8930833333333332,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "А если все мои места будут заняты?"
    },
    {
      "id": "rm0117_frag0013",
      "role": "vendor",
      "pool": "full",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0013.thn",
      "sha256": "09dcf5e1fb358d2d7d4abcfd7924911b1deeb72fe47c64503aa87a4f47dd057a",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0013_l001_vendor.wav",
      "audio_sha256": "eb66f2ac12d29b650c2e9e110bb147a19f725475e5e16b01cf6cf781dc075cc5",
      "sound": "DX_rm0117_frag0013_l001_vendor_ru",
      "speech_seconds": 9.698208333333334,
      "scene_seconds": 11.148208333333335,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Ещё один корабль поставить не получится. Но можно забрать оставленный или обменять его на текущий. Для обмена свободное место не нужно."
    },
    {
      "id": "rm0117_frag0014",
      "role": "vendor",
      "pool": "no_money",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0014.thn",
      "sha256": "9d5d3ad0ef9ae9584327e1b7abc5cc15df434671ad859e989a6a9b74f24f55f0",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0014_l001_vendor.wav",
      "audio_sha256": "33a200b989f7b33df121988430b0258da668bd71809588dd822c93523d55f115",
      "sound": "DX_rm0117_frag0014_l001_vendor_ru",
      "speech_seconds": 6.346,
      "scene_seconds": 7.796,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "На счету недостаточно кредитов. Оплата не прошла. Возвращайся, когда будет нужная сумма."
    },
    {
      "id": "rm0117_frag0015",
      "role": "vendor",
      "pool": "maximum",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0015.thn",
      "sha256": "632347fe8e439e40ebf0124b6dad6156a3d302ac53fb00c6edb5d26f41984527",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0015_l001_vendor.wav",
      "audio_sha256": "497d62330f1730596aff9c3c98eb82a9e91da7e64882128a7e0171319bcfa57d",
      "sound": "DX_rm0117_frag0015_l001_vendor_ru",
      "speech_seconds": 5.673583333333333,
      "scene_seconds": 7.123583333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Ты уже приобрёл все доступные тебе места на этой базе. Ещё одно оформить не могу."
    },
    {
      "id": "rm0117_frag0016",
      "role": "vendor",
      "pool": "error",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0016.thn",
      "sha256": "c37a98aade76153c6e2a28325b2ead6f95b4aa8d2f44949a24888c51abb0b0ce",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0016_l001_vendor.wav",
      "audio_sha256": "097b5d322cc380d69eb6e85a14720c59808b8a8ecaaccd5677b93dd8aedb42ca",
      "sound": "DX_rm0117_frag0016_l001_vendor_ru",
      "speech_seconds": 5.700083333333334,
      "scene_seconds": 7.150083333333334,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Оформить покупку не удалось. Деньги не списаны. Давай проверим условия ещё раз."
    },
    {
      "id": "rm0117_frag0017",
      "role": "player",
      "pool": "back",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0017.thn",
      "sha256": "67493dd7756a79fb66c4ddd0cf2896ed546c204bfdcaa4606439abdc9f17955c",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0017_l001_player.wav",
      "audio_sha256": "0be99bf69573c07a9a459a439a6d17ebc8ca018c5a86ca3d6106e51952128d57",
      "sound": "DX_rm0117_frag0017_l001_player_ru",
      "speech_seconds": 1.850625,
      "scene_seconds": 3.3006249999999997,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Вернёмся к покупке места."
    },
    {
      "id": "rm0117_frag0018",
      "role": "player",
      "pool": "leave",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0018.thn",
      "sha256": "86a1c69ca3a05cc46d6b0ac029e7939f39925e22f4205fcbba752df693d5ff8c",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0018_l001_player.wav",
      "audio_sha256": "18fe3999cec3b73bcd80cb71bdb4d29f79b5f97db8a3ba4105cfb3300720184a",
      "sound": "DX_rm0117_frag0018_l001_player_ru",
      "speech_seconds": 2.4040416666666666,
      "scene_seconds": 3.8540416666666664,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "На этом всё. До встречи, комендант."
    },
    {
      "id": "rm0117_frag0019",
      "role": "vendor",
      "pool": "farewell",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0019.thn",
      "sha256": "d6c8b0c4bd122fd49d2d906f942e7b6f57e4d497a9d66bd237fa7a791feb923e",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0019_l001_vendor.wav",
      "audio_sha256": "19c97f59de116c1f6d00c50bf22af4967518ca938fce2f0368bda9d7baadb1f2",
      "sound": "DX_rm0117_frag0019_l001_vendor_ru",
      "speech_seconds": 2.527,
      "scene_seconds": 3.977,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "До встречи, Трент. Удачных полётов."
    },
    {
      "id": "rm0117_frag0020",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0020.thn",
      "sha256": "fe1e2b61217d728e513ef7b187eb386e429d87047ba46e9f104d4a68ea2d4171",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0020_l001_vendor.wav",
      "audio_sha256": "9b9dfb4adfc190a805150fc2b69701ae95c6965ffefb9979f06354474751c465",
      "sound": "DX_rm0117_frag0020_l001_vendor_ru",
      "speech_seconds": 4.192166666666667,
      "scene_seconds": 5.642166666666667,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "С возвращением. Комендант Хейз слушает. По поводу стоянки?"
