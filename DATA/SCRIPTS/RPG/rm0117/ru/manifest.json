    {
      "id": "rm0117_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0021.thn",
      "sha256": "3cd381c5961f2ac42161df8dee94f0d0f1ede87b41f8dee9dfd34d5e70cb39d7",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0021_l001_vendor.wav",
      "audio_sha256": "2f1c580ef42e1d27a8f36683d52254a75966cd113f38323dcf25202ee91e74c2",
      "sound": "DX_rm0117_frag0021_l001_vendor_ru",
      "speech_seconds": 2.7545,
      "scene_seconds": 4.2044999999999995,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Привет, Трент. Стоянка к твоим услугам."
    },
    {
      "id": "rm0117_frag0022",
      "role": "vendor",
      "pool": "success",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0022.thn",
      "sha256": "a4d7b1637d0cb87a5cb40c3ffb4782fd976264b95b5b0e84c7d4c72d4a13da47",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0022_l001_vendor.wav",
      "audio_sha256": "968a6e73a5ad28ac6b7c8f29ae394b27a56b1717299fa0a4a53b7f22699864b0",
      "sound": "DX_rm0117_frag0022_l001_vendor_ru",
      "speech_seconds": 4.0295,
      "scene_seconds": 5.4795,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Готово. Место оплачено и закреплено за тобой. Пользуйся."
    },
    {
      "id": "rm0117_frag0023",
      "role": "vendor",
      "pool": "bad_reputation",
      "path": "SCRIPTS/RPG/rm0117/ru/rm0117_frag0023.thn",
      "sha256": "eee03ea2db44ef7391533e4baa10cee0dce27a228aae7c089fe888e6c93954cb",
      "audio": "AUDIO/MOD/RPG/rm0117/rm0117_frag0023_l001_vendor.wav",
