      "audio": "AUDIO/MOD/RPG/rm0153/rm0153_frag0019_l001_vendor.wav",
      "audio_sha256": "19c97f59de116c1f6d00c50bf22af4967518ca938fce2f0368bda9d7baadb1f2",
      "sound": "DX_rm0153_frag0019_l001_vendor_ru",
      "speech_seconds": 2.527,
      "scene_seconds": 3.977,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "До встречи, Трент. Удачных полётов."
    },
    {
      "id": "rm0153_frag0020",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0153/ru/rm0153_frag0020.thn",
