      "audio_sha256": "f552b7bd39259ecf3221028d379d1c96b3d738f743dd8fc190ed5e8b8643dbc8",
      "sound": "DX_rm0135_frag0012_l001_player_ru",
      "speech_seconds": 2.4430833333333335,
      "scene_seconds": 3.8930833333333332,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "А если все мои места будут заняты?"
    },
    {
      "id": "rm0135_frag0013",
      "role": "vendor",
      "pool": "full",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0013.thn",
      "sha256": "8c79aece7afc0b6174422558fc2cc5335be611842e864874bf06343ac574ba64",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0013_l001_vendor.wav",
      "audio_sha256": "eb66f2ac12d29b650c2e9e110bb147a19f725475e5e16b01cf6cf781dc075cc5",
      "sound": "DX_rm0135_frag0013_l001_vendor_ru",
      "speech_seconds": 9.698208333333334,
      "scene_seconds": 11.148208333333335,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Ещё один корабль поставить не получится. Но можно забрать оставленный или обменять его на текущий. Для обмена свободное место не нужно."
    },
    {
      "id": "rm0135_frag0014",
      "role": "vendor",
      "pool": "no_money",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0014.thn",
      "sha256": "67ad6c679571ca2c289ac398980065ee8016a9e84e07d35b02d62af02d71f611",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0014_l001_vendor.wav",
      "audio_sha256": "33a200b989f7b33df121988430b0258da668bd71809588dd822c93523d55f115",
      "sound": "DX_rm0135_frag0014_l001_vendor_ru",
      "speech_seconds": 6.346,
      "scene_seconds": 7.796,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "На счету недостаточно кредитов. Оплата не прошла. Возвращайся, когда будет нужная сумма."
    },
    {
      "id": "rm0135_frag0015",
      "role": "vendor",
      "pool": "maximum",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0015.thn",
      "sha256": "ebcf1f605b013e3d2e13b4bf9ae1ef74684af8aed4071c141515bc53d8bbbcec",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0015_l001_vendor.wav",
      "audio_sha256": "497d62330f1730596aff9c3c98eb82a9e91da7e64882128a7e0171319bcfa57d",
      "sound": "DX_rm0135_frag0015_l001_vendor_ru",
      "speech_seconds": 5.673583333333333,
      "scene_seconds": 7.123583333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Ты уже приобрёл все доступные тебе места на этой базе. Ещё одно оформить не могу."
    },
    {
      "id": "rm0135_frag0016",
      "role": "vendor",
      "pool": "error",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0016.thn",
      "sha256": "1a262a11f92f8fc419d4e40b82486c910e7d2c527ad6bfb0e40cc4c996cad86a",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0016_l001_vendor.wav",
      "audio_sha256": "097b5d322cc380d69eb6e85a14720c59808b8a8ecaaccd5677b93dd8aedb42ca",
      "sound": "DX_rm0135_frag0016_l001_vendor_ru",
      "speech_seconds": 5.700083333333334,
      "scene_seconds": 7.150083333333334,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Оформить покупку не удалось. Деньги не списаны. Давай проверим условия ещё раз."
    },
    {
      "id": "rm0135_frag0017",
      "role": "player",
      "pool": "back",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0017.thn",
      "sha256": "3a25d9780d610236d64e54f4c44aeb7e823f4861b24005b4c383995892197223",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0017_l001_player.wav",
      "audio_sha256": "0be99bf69573c07a9a459a439a6d17ebc8ca018c5a86ca3d6106e51952128d57",
      "sound": "DX_rm0135_frag0017_l001_player_ru",
      "speech_seconds": 1.850625,
      "scene_seconds": 3.3006249999999997,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Вернёмся к покупке места."
    },
    {
      "id": "rm0135_frag0018",
      "role": "player",
      "pool": "leave",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0018.thn",
      "sha256": "5c943de21d216f646e5350057275ee95d5d945d0090081a303dda18b8d1c985c",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0018_l001_player.wav",
      "audio_sha256": "18fe3999cec3b73bcd80cb71bdb4d29f79b5f97db8a3ba4105cfb3300720184a",
      "sound": "DX_rm0135_frag0018_l001_player_ru",
      "speech_seconds": 2.4040416666666666,
      "scene_seconds": 3.8540416666666664,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "На этом всё. До встречи, комендант."
    },
    {
      "id": "rm0135_frag0019",
      "role": "vendor",
      "pool": "farewell",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0019.thn",
      "sha256": "d3785cdea7f822d333c0b24850c6231bdf51aecfd809c872a3c2b536434e7bab",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0019_l001_vendor.wav",
      "audio_sha256": "19c97f59de116c1f6d00c50bf22af4967518ca938fce2f0368bda9d7baadb1f2",
      "sound": "DX_rm0135_frag0019_l001_vendor_ru",
      "speech_seconds": 2.527,
      "scene_seconds": 3.977,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "До встречи, Трент. Удачных полётов."
    },
    {
      "id": "rm0135_frag0020",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0020.thn",
      "sha256": "b78759f7ad2ddd766f47c45e69cd065af460e01ea9b8f780f6a505da8372f54a",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0020_l001_vendor.wav",
