      "sound": "DX_rm0135_frag0020_l001_vendor_ru",
      "speech_seconds": 4.295333333333334,
      "scene_seconds": 5.745333333333334,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "С возвращением. Комендант Вебер слушает. По поводу стоянки?"
