    {
      "id": "rm0135_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0021.thn",
      "sha256": "c783c7cbe9925cafe273396e67961793f26f980b618cdacf32c63752e3fe2003",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0021_l001_vendor.wav",
      "audio_sha256": "2f1c580ef42e1d27a8f36683d52254a75966cd113f38323dcf25202ee91e74c2",
      "sound": "DX_rm0135_frag0021_l001_vendor_ru",
      "speech_seconds": 2.7545,
      "scene_seconds": 4.2044999999999995,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Привет, Трент. Стоянка к твоим услугам."
    },
    {
      "id": "rm0135_frag0022",
      "role": "vendor",
      "pool": "success",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0022.thn",
      "sha256": "67ce29705d63a5db35a63385be46aa17ef594e2829b4f1d8623cd77599887c12",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0022_l001_vendor.wav",
      "audio_sha256": "968a6e73a5ad28ac6b7c8f29ae394b27a56b1717299fa0a4a53b7f22699864b0",
      "sound": "DX_rm0135_frag0022_l001_vendor_ru",
      "speech_seconds": 4.0295,
      "scene_seconds": 5.4795,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Готово. Место оплачено и закреплено за тобой. Пользуйся."
    },
    {
      "id": "rm0135_frag0023",
      "role": "vendor",
      "pool": "bad_reputation",
      "path": "SCRIPTS/RPG/rm0135/ru/rm0135_frag0023.thn",
      "sha256": "053776021e1c4ff7b6a4a793d8908b0825f85c727404eef8757fd255d3ea47ae",
      "audio": "AUDIO/MOD/RPG/rm0135/rm0135_frag0023_l001_vendor.wav",
      "audio_sha256": "fe39ce0e1870974185fb32e9a305d28735bbc5005a292e4bfe2bfd8c92624677",
