      "sound": "DX_rm0142_frag0012_l001_player_ru",
      "speech_seconds": 2.4430833333333335,
      "scene_seconds": 3.8930833333333332,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "А если все мои места будут заняты?"
    },
    {
      "id": "rm0142_frag0013",
      "role": "vendor",
      "pool": "full",
      "path": "SCRIPTS/RPG/rm0142/ru/rm0142_frag0013.thn",
      "sha256": "f137e25a256ec4336bb876ef4515de7b1d1598eef653cd4957f88f6ed25b129f",
      "audio": "AUDIO/MOD/RPG/rm0142/rm0142_frag0013_l001_vendor.wav",
