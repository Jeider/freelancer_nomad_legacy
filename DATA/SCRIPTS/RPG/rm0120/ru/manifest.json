    {
      "id": "rm0120_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0120/ru/rm0120_frag0021.thn",
      "sha256": "60e7cd5e58afa426582f71333feb19e7c57880970d2b5b3a8bababd9e0c74274",
      "audio": "AUDIO/MOD/RPG/rm0120/rm0120_frag0021_l001_vendor.wav",
