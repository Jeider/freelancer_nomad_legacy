      "speech_seconds": 2.527,
      "scene_seconds": 3.977,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "До встречи, Трент. Удачных полётов."
    },
    {
      "id": "rm0120_frag0020",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0120/ru/rm0120_frag0020.thn",
