      "id": "rm0149_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0149/ru/rm0149_frag0021.thn",
      "sha256": "5dacf4736fd4937c2067f8173e25f6caac634bd9a31e0d915162e5a351618d5e",
      "audio": "AUDIO/MOD/RPG/rm0149/rm0149_frag0021_l001_vendor.wav",
      "audio_sha256": "2f1c580ef42e1d27a8f36683d52254a75966cd113f38323dcf25202ee91e74c2",
