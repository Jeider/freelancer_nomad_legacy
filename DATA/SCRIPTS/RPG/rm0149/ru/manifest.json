      "speech_seconds": 2.527,
      "scene_seconds": 3.977,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "До встречи, Трент. Удачных полётов."
    },
    {
      "id": "rm0149_frag0020",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0149/ru/rm0149_frag0020.thn",
      "sha256": "6e977b7153574539c3554bb9a622503c2dd21d34e95e365b2683d2b707e1a0e7",
      "audio": "AUDIO/MOD/RPG/rm0149/rm0149_frag0020_l001_vendor.wav",
