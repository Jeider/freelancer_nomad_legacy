    {
      "id": "rm0110_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0110/ru/rm0110_frag0021.thn",
      "sha256": "12b168cc2053998169a338b89bf5adc4ce8464fbf2a5db27c91f08aed221b84a",
      "audio": "AUDIO/MOD/RPG/rm0110/rm0110_frag0021_l001_vendor.wav",
      "audio_sha256": "2f1c580ef42e1d27a8f36683d52254a75966cd113f38323dcf25202ee91e74c2",
