    {
      "id": "rm0134_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0134/ru/rm0134_frag0021.thn",
      "sha256": "82e13c038d9b65422dac6a3b69ea9283e952555d982ae230fcd499a30d77dc7f",
      "audio": "AUDIO/MOD/RPG/rm0134/rm0134_frag0021_l001_vendor.wav",
      "audio_sha256": "2f1c580ef42e1d27a8f36683d52254a75966cd113f38323dcf25202ee91e74c2",
