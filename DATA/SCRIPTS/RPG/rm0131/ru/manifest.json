      "audio": "AUDIO/MOD/RPG/rm0131/rm0131_frag0019_l001_vendor.wav",
      "audio_sha256": "19c97f59de116c1f6d00c50bf22af4967518ca938fce2f0368bda9d7baadb1f2",
      "sound": "DX_rm0131_frag0019_l001_vendor_ru",
      "speech_seconds": 2.527,
      "scene_seconds": 3.977,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "До встречи, Трент. Удачных полётов."
    },
    {
      "id": "rm0131_frag0020",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0131/ru/rm0131_frag0020.thn",
      "sha256": "107ea08a52f5f8e9d9f6f9f411f54c10f409e0aeee2102e48e7845ee9816c289",
      "audio": "AUDIO/MOD/RPG/rm0131/rm0131_frag0020_l001_vendor.wav",
