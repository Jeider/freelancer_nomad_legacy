      "speech_seconds": 2.527,
      "scene_seconds": 3.977,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "До встречи, Трент. Удачных полётов."
    },
    {
      "id": "rm0127_frag0020",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0127/ru/rm0127_frag0020.thn",
      "sha256": "b58ef7ec6d85e9bf047c6ed9cbcaa0dfbd9683b8a8f97e4db4f001e19bd9ddf1",
      "audio": "AUDIO/MOD/RPG/rm0127/rm0127_frag0020_l001_vendor.wav",
