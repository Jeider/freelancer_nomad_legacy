    {
      "id": "rm0127_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0127/ru/rm0127_frag0021.thn",
      "sha256": "3c8278e4a082b8e9b536bd0ba6f625e8c372e73cafc6ffd543e2de9808ab2ad0",
      "audio": "AUDIO/MOD/RPG/rm0127/rm0127_frag0021_l001_vendor.wav",
      "audio_sha256": "2f1c580ef42e1d27a8f36683d52254a75966cd113f38323dcf25202ee91e74c2",
      "sound": "DX_rm0127_frag0021_l001_vendor_ru",
      "speech_seconds": 2.7545,
      "scene_seconds": 4.2044999999999995,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Привет, Трент. Стоянка к твоим услугам."
    },
    {
      "id": "rm0127_frag0022",
      "role": "vendor",
      "pool": "success",
      "path": "SCRIPTS/RPG/rm0127/ru/rm0127_frag0022.thn",
