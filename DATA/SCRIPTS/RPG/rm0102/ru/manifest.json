      "sound": "DX_rm0102_frag0018_l001_player_ru",
      "speech_seconds": 2.4040416666666666,
      "scene_seconds": 3.8540416666666664,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "На этом всё. До встречи, комендант."
    },
    {
      "id": "rm0102_frag0019",
      "role": "vendor",
      "pool": "farewell",
      "path": "SCRIPTS/RPG/rm0102/ru/rm0102_frag0019.thn",
      "sha256": "3ee2a387eeeefd716d6f8b3b390f723be19c4e90a86749a8286627e17a829ce7",
      "audio": "AUDIO/MOD/RPG/rm0102/rm0102_frag0019_l001_vendor.wav",
      "audio_sha256": "19c97f59de116c1f6d00c50bf22af4967518ca938fce2f0368bda9d7baadb1f2",
      "sound": "DX_rm0102_frag0019_l001_vendor_ru",
      "speech_seconds": 2.527,
      "scene_seconds": 3.977,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "До встречи, Трент. Удачных полётов."
    },
    {
      "id": "rm0102_frag0020",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0102/ru/rm0102_frag0020.thn",
      "sha256": "a860cc8bed89846604943df146fe9eab138f99dca2ba8307634056719399dbe9",
      "audio": "AUDIO/MOD/RPG/rm0102/rm0102_frag0020_l001_vendor.wav",
