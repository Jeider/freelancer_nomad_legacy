      "audio": "AUDIO/MOD/RPG/rm0148/rm0148_frag0022_l001_vendor.wav",
      "audio_sha256": "968a6e73a5ad28ac6b7c8f29ae394b27a56b1717299fa0a4a53b7f22699864b0",
