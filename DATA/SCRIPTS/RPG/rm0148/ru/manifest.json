      "id": "rm0148_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0148/ru/rm0148_frag0021.thn",
      "sha256": "b0de8b3dd26a948a4b53012dd58122a7c373e196ebe74eccb4cc22fac8017621",
      "audio": "AUDIO/MOD/RPG/rm0148/rm0148_frag0021_l001_vendor.wav",
