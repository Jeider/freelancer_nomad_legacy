      "id": "rm0146_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0146/ru/rm0146_frag0021.thn",
      "sha256": "4653e6c80f0e179086309313f495741b612293f06573ef901273be90eb9e6e1b",
      "audio": "AUDIO/MOD/RPG/rm0146/rm0146_frag0021_l001_vendor.wav",
