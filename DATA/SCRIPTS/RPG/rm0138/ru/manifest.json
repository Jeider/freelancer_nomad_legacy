    {
      "id": "rm0138_frag0021",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0138/ru/rm0138_frag0021.thn",
      "sha256": "1b892ea397b3c8940954f7bc652da064ec0fce6fe029d9390e744a575d679812",
      "audio": "AUDIO/MOD/RPG/rm0138/rm0138_frag0021_l001_vendor.wav",
      "audio_sha256": "2f1c580ef42e1d27a8f36683d52254a75966cd113f38323dcf25202ee91e74c2",
      "sound": "DX_rm0138_frag0021_l001_vendor_ru",
      "speech_seconds": 2.7545,
      "scene_seconds": 4.2044999999999995,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Привет, Трент. Стоянка к твоим услугам."
    },
    {
      "id": "rm0138_frag0022",
      "role": "vendor",
      "pool": "success",
      "path": "SCRIPTS/RPG/rm0138/ru/rm0138_frag0022.thn",
