      "audio": "AUDIO/MOD/RPG/rm0138/rm0138_frag0022_l001_vendor.wav",
      "audio_sha256": "968a6e73a5ad28ac6b7c8f29ae394b27a56b1717299fa0a4a53b7f22699864b0",
      "sound": "DX_rm0138_frag0022_l001_vendor_ru",
      "speech_seconds": 4.0295,
      "scene_seconds": 5.4795,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Готово. Место оплачено и закреплено за тобой. Пользуйся."
    },
    {
      "id": "rm0138_frag0023",
      "role": "vendor",
      "pool": "bad_reputation",
      "path": "SCRIPTS/RPG/rm0138/ru/rm0138_frag0023.thn",
      "sha256": "331a9ecacf18414b9edd3526feaddf045022bbd1c76939b88266671e67920d6f",
