      "audio_sha256": "f552b7bd39259ecf3221028d379d1c96b3d738f743dd8fc190ed5e8b8643dbc8",
      "sound": "DX_rm0138_frag0012_l001_player_ru",
      "speech_seconds": 2.4430833333333335,
      "scene_seconds": 3.8930833333333332,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "А если все мои места будут заняты?"
    },
    {
      "id": "rm0138_frag0013",
      "role": "vendor",
      "pool": "full",
      "path": "SCRIPTS/RPG/rm0138/ru/rm0138_frag0013.thn",
      "sha256": "2611455409976365940f491bada89f0bf3aea3cc21f4eb199a3c7e1604f2bb4a",
      "audio": "AUDIO/MOD/RPG/rm0138/rm0138_frag0013_l001_vendor.wav",
      "audio_sha256": "eb66f2ac12d29b650c2e9e110bb147a19f725475e5e16b01cf6cf781dc075cc5",
      "sound": "DX_rm0138_frag0013_l001_vendor_ru",
      "speech_seconds": 9.698208333333334,
      "scene_seconds": 11.148208333333335,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Ещё один корабль поставить не получится. Но можно забрать оставленный или обменять его на текущий. Для обмена свободное место не нужно."
    },
    {
      "id": "rm0138_frag0014",
      "role": "vendor",
      "pool": "no_money",
      "path": "SCRIPTS/RPG/rm0138/ru/rm0138_frag0014.thn",
      "sha256": "b6a6edecb2e03cd34600a619f172057559193509dd6072b7341e2e781da14535",
      "audio": "AUDIO/MOD/RPG/rm0138/rm0138_frag0014_l001_vendor.wav",
      "audio_sha256": "33a200b989f7b33df121988430b0258da668bd71809588dd822c93523d55f115",
      "sound": "DX_rm0138_frag0014_l001_vendor_ru",
      "speech_seconds": 6.346,
      "scene_seconds": 7.796,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "На счету недостаточно кредитов. Оплата не прошла. Возвращайся, когда будет нужная сумма."
    },
    {
      "id": "rm0138_frag0015",
      "role": "vendor",
      "pool": "maximum",
      "path": "SCRIPTS/RPG/rm0138/ru/rm0138_frag0015.thn",
      "sha256": "0229c0862ec9fe7f0f49a738f045993e1c703c3283426ee2f041a3cdb452dea8",
      "audio": "AUDIO/MOD/RPG/rm0138/rm0138_frag0015_l001_vendor.wav",
      "audio_sha256": "497d62330f1730596aff9c3c98eb82a9e91da7e64882128a7e0171319bcfa57d",
      "sound": "DX_rm0138_frag0015_l001_vendor_ru",
      "speech_seconds": 5.673583333333333,
      "scene_seconds": 7.123583333333333,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Ты уже приобрёл все доступные тебе места на этой базе. Ещё одно оформить не могу."
    },
    {
      "id": "rm0138_frag0016",
      "role": "vendor",
      "pool": "error",
      "path": "SCRIPTS/RPG/rm0138/ru/rm0138_frag0016.thn",
      "sha256": "a6787c65f93b14de329390f7f0cfcb0bfb748c28426b1480ccb7561e1f139715",
      "audio": "AUDIO/MOD/RPG/rm0138/rm0138_frag0016_l001_vendor.wav",
      "audio_sha256": "097b5d322cc380d69eb6e85a14720c59808b8a8ecaaccd5677b93dd8aedb42ca",
      "sound": "DX_rm0138_frag0016_l001_vendor_ru",
      "speech_seconds": 5.700083333333334,
      "scene_seconds": 7.150083333333334,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Оформить покупку не удалось. Деньги не списаны. Давай проверим условия ещё раз."
    },
    {
      "id": "rm0138_frag0017",
      "role": "player",
      "pool": "back",
      "path": "SCRIPTS/RPG/rm0138/ru/rm0138_frag0017.thn",
      "sha256": "a210ebfc9f500ace9609bb5bd82e161f8e3fd1bad8775641d80ef94f3ce62d5c",
      "audio": "AUDIO/MOD/RPG/rm0138/rm0138_frag0017_l001_player.wav",
      "audio_sha256": "0be99bf69573c07a9a459a439a6d17ebc8ca018c5a86ca3d6106e51952128d57",
      "sound": "DX_rm0138_frag0017_l001_player_ru",
      "speech_seconds": 1.850625,
      "scene_seconds": 3.3006249999999997,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Вернёмся к покупке места."
    },
    {
      "id": "rm0138_frag0018",
      "role": "player",
      "pool": "leave",
      "path": "SCRIPTS/RPG/rm0138/ru/rm0138_frag0018.thn",
      "sha256": "db6370acf888b85b2ef1a9c1539459192cf616fe388f736a3e9141526559cfce",
      "audio": "AUDIO/MOD/RPG/rm0138/rm0138_frag0018_l001_player.wav",
