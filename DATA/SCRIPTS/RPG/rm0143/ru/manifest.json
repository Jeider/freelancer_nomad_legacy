      "speech_seconds": 2.4040416666666666,
      "scene_seconds": 3.8540416666666664,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "На этом всё. До встречи, комендант."
    },
    {
      "id": "rm0143_frag0019",
      "role": "vendor",
      "pool": "farewell",
      "path": "SCRIPTS/RPG/rm0143/ru/rm0143_frag0019.thn",
      "sha256": "2ac563449323d45f3768b2a0dae898322c6beecf0f00373030a608092440fa24",
      "audio": "AUDIO/MOD/RPG/rm0143/rm0143_frag0019_l001_vendor.wav",
      "audio_sha256": "19c97f59de116c1f6d00c50bf22af4967518ca938fce2f0368bda9d7baadb1f2",
      "sound": "DX_rm0143_frag0019_l001_vendor_ru",
      "speech_seconds": 2.527,
      "scene_seconds": 3.977,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "До встречи, Трент. Удачных полётов."
    },
    {
      "id": "rm0143_frag0020",
      "role": "vendor",
      "pool": "greeting",
      "path": "SCRIPTS/RPG/rm0143/ru/rm0143_frag0020.thn",
      "sha256": "9d4eb187c1c0851841411a01847262b6c568e8e0dcc374521b994022bab66497",
      "audio": "AUDIO/MOD/RPG/rm0143/rm0143_frag0020_l001_vendor.wav",
