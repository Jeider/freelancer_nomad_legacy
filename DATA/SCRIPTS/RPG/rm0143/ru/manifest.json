      "audio": "AUDIO/MOD/RPG/rm0143/rm0143_frag0022_l001_vendor.wav",
      "audio_sha256": "968a6e73a5ad28ac6b7c8f29ae394b27a56b1717299fa0a4a53b7f22699864b0",
      "sound": "DX_rm0143_frag0022_l001_vendor_ru",
      "speech_seconds": 4.0295,
      "scene_seconds": 5.4795,
      "facial_timing": "Character.facial(auto_lip=True)",
      "text": "Готово. Место оплачено и закреплено за тобой. Пользуйся."
    },
    {
      "id": "rm0143_frag0023",
      "role": "vendor",
      "pool": "bad_reputation",
      "path": "SCRIPTS/RPG/rm0143/ru/rm0143_frag0023.thn",
      "sha256": "38050a72c018ead5e0ca130e74e450e39550128b46e5b0c46af413375ee991eb",
      "audio": "AUDIO/MOD/RPG/rm0143/rm0143_frag0023_l001_vendor.wav",
